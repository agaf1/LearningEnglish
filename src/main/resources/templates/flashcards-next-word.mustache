<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>flashcards-next-word</title>
    <link rel="stylesheet" href="/static/css/mystyle.css">
</head>
<body>
<div>
    <h3> Translate this word: (Przetlumacz podane slowo:)</h3>
    <input type="text" name="polishVersion" value="{{phrase.polishVersion}}"/>

    <form action="/{{userId}}/flashcards/translate/{{phrase.id}}" method="post">
        <label>
            <input type="text" name="englishVersion"/>
        </label>
        <input type="submit"/>
    </form>
</div>
</body>
</html>